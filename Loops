-- for loop
for i = 1, 5, 1 do -- x, y, z - x is starting value, y is end value, z is the increment value
	print(i)
end

for i = 5, 1, -1 do -- you can actually increment backwards, this counts backwards instead but still runs the same amount of times as code above
	print(i)
end

-- while loop
local whileCounter = 1

while whileCounter <= 5 do 
	print(whileCounter)
	whileCounter += 1 -- this means whileCounter = whileCounter + 1 for short
end

--you can have loops inside of loops, these are called 'nested' loops

for i = 1, 5, 1 do 
	print('A')
	for i = 1, 3, 1 do 
		print('B')
	end
end


