-- using return

local function addition2(N1, N2)
	local result = N1 + N2
	return result
end
local printResult = addition2(5, 2) -- the return assigns the result to addition2(5, 2) so now its like a variable where addition2 just equals the result
print(printResult) -- since the function behaves kind of like a variable with a value now, printing the function will print the result
 
