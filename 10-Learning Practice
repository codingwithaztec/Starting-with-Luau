--Return and conditions
local function checkNumber(num)
	if num > 0 then
		return 'Positive'
	elseif num < 0 then
		return 'Negative'
	else
		return 'Zero'
	end
end

print(checkNumber(0))
print(checkNumber(10))
print(checkNumber(-10))

