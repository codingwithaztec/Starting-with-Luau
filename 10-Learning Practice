-- Multiplier calculator
local function multiplier(num1, num2)
	local result = num1 * num2
	print(result)
end

multiplier(5, 10)

-- Bigger number
local function biggerNumber(numb1, numb2)
	if numb1 > numb2 then
		print(numb1 .. ' is bigger') -- .. can be used to add strings, the space in the ' is bigger' is to add a space between the two
	elseif numb2 > numb1 then
		print(numb2 .. ' is bigger')
	else
		print('Equal')
	end
end

biggerNumber(10, 10)
biggerNumber(12, 10)
biggerNumber(8, 10)

-- strength calculator
local clickgain = 1
local multiplier = 1
local strength = 0

local function strengthCalc()
	local strengthGain = clickgain * multiplier
	strength = strength + strengthGain
	print(strength)
end

strengthCalc()
strengthCalc()
strengthCalc()
print(strength)

-- Strength requirements
if strength >= 10 and strength <50 then
	print("You're getting strong!")
elseif strength >= 50 and strength < 100 then
	print("You're strong!")
elseif strength < 10 then
	print("You're still weak")
else 
	print("You're very strong!")
end

